{
  "name": "google-appscript-mcp-server",
  "version": "1.1.0",
  "description": "MCP server for the Google Apps Script API. Fork of mohalmah/google-appscript-mcp-server with OAuth/stdio/error-contract fixes and added web-app publish + project-discovery capabilities.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "list-tools": "node index.js tools",
    "test": "LOG_LEVEL=error node --test test/*.test.js",
    "test:integration": "LOG_LEVEL=error RUN_INTEGRATION=1 node --test test/integration.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"lib/**/*.js\" \"tools/**/*.js\" \"test/**/*.js\" mcpServer.js index.js",
    "format:check": "prettier --check \"lib/**/*.js\" \"tools/**/*.js\" \"test/**/*.js\" mcpServer.js index.js",
    "setup-oauth": "node oauth-setup.js",
    "start": "node mcpServer.js",
    "start-sse": "node mcpServer.js --sse",
    "debug": "LOG_LEVEL=debug node mcpServer.js",
    "debug-sse": "LOG_LEVEL=debug node mcpServer.js --sse"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "googleapis": "^173.0.0",
    "open": "^10.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Andy Conley",
  "contributors": [
    "mohalmah (original author) <https://github.com/mohalmah>",
    "Postman, Inc. (initial codegen)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andyconley/google-appscript-mcp-server.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6"
  }
}
